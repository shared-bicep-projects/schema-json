{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ARM Template Parameters - COP Orchestrator (iac-bicep-co)",
    "description": "Parameter file schema for the iac-bicep-co mg-scope and sub-scope full-parameters test deployments.",
    "type": "object",
    "required": ["$schema", "contentVersion", "parameters"],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "The URI of the JSON schema for this parameters file."
        },
        "contentVersion": {
            "type": "string",
            "description": "Version of the content in major.minor.build.revision format.",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "parameters": {
            "type": "object",
            "description": "Deployment parameter values.",
            "required": ["commonParameters"],
            "additionalProperties": false,
            "properties": {
                "commonParameters": {
                    "type": "object",
                    "description": "Common subscription identifiers required by the module. Forwarded, as-is, to every COP module orchestrated by this module.",
                    "required": ["value"],
                    "additionalProperties": false,
                    "properties": {
                        "value": {
                            "type": "object",
                            "description": "Object containing shared subscription GUIDs and optional resource group names.",
                            "required": ["identitySubscriptionGuid", "managementSubscriptionGuid"],
                            "additionalProperties": false,
                            "properties": {
                                "identitySubscriptionGuid": {
                                    "type": "string",
                                    "description": "Subscription GUID for the identity subscription.",
                                    "minLength": 36,
                                    "maxLength": 36,
                                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                                },
                                "managementSubscriptionGuid": {
                                    "type": "string",
                                    "description": "Subscription GUID for the management subscription.",
                                    "minLength": 36,
                                    "maxLength": 36,
                                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                                },
                                "identityRgName": {
                                    "type": "string",
                                    "description": "Resource group name for the identity subscription.",
                                    "minLength": 3,
                                    "maxLength": 90
                                },
                                "monitoringRgName": {
                                    "type": "string",
                                    "description": "Resource group name for the foundation monitoring resources.",
                                    "minLength": 3,
                                    "maxLength": 90
                                },
                                "location": {
                                    "type": "string",
                                    "description": "Azure region for resource group deployments. Defaults to the deployment location if omitted."
                                },
                                "identityRgTags": {
                                    "type": "object",
                                    "description": "Tags applied to the identity resource group and to the platform user-assigned managed identities.",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                },
                                "copAcsRgName": {
                                    "type": "string",
                                    "description": "Resource group name override for the COP Communication Services module resources.",
                                    "minLength": 3,
                                    "maxLength": 90
                                },
                                "copAgwRgName": {
                                    "type": "string",
                                    "description": "Resource group name override for the COP Application Gateway module resources.",
                                    "minLength": 3,
                                    "maxLength": 90
                                },
                                "copApimRgName": {
                                    "type": "string",
                                    "description": "Resource group name override for the COP API Management module resources.",
                                    "minLength": 3,
                                    "maxLength": 90
                                },
                                "copAppRgName": {
                                    "type": "string",
                                    "description": "Resource group name override for the COP App Service module resources.",
                                    "minLength": 3,
                                    "maxLength": 90
                                },
                                "copCaRgName": {
                                    "type": "string",
                                    "description": "Resource group name override for the COP Container App module resources.",
                                    "minLength": 3,
                                    "maxLength": 90
                                },
                                "copCrRgName": {
                                    "type": "string",
                                    "description": "Resource group name override for the COP Container Registry module resources.",
                                    "minLength": 3,
                                    "maxLength": 90
                                },
                                "copCredRgName": {
                                    "type": "string",
                                    "description": "Resource group name override for the COP Credentials module resources.",
                                    "minLength": 3,
                                    "maxLength": 90
                                },
                                "copFdRgName": {
                                    "type": "string",
                                    "description": "Resource group name override for the COP Front Door module resources.",
                                    "minLength": 3,
                                    "maxLength": 90
                                },
                                "copLbRgName": {
                                    "type": "string",
                                    "description": "Resource group name override for the COP Load Balancer module resources.",
                                    "minLength": 3,
                                    "maxLength": 90
                                },
                                "copSbnsRgName": {
                                    "type": "string",
                                    "description": "Resource group name override for the COP Service Bus Namespace module resources.",
                                    "minLength": 3,
                                    "maxLength": 90
                                },
                                "copSqldbRgName": {
                                    "type": "string",
                                    "description": "Resource group name override for the COP SQL Database module resources.",
                                    "minLength": 3,
                                    "maxLength": 90
                                },
                                "copStRgName": {
                                    "type": "string",
                                    "description": "Resource group name override for the COP Storage Account module resources.",
                                    "minLength": 3,
                                    "maxLength": 90
                                }
                            }
                        }
                    }
                },
                "foundationResources": {
                    "type": "object",
                    "description": "Names and location of pre-existing foundation resources. Forwarded, as-is, to every COP module orchestrated by this module.",
                    "required": ["value"],
                    "additionalProperties": false,
                    "properties": {
                        "value": {
                            "type": "object",
                            "description": "Object containing references to existing foundation resources.",
                            "additionalProperties": false,
                            "properties": {
                                "contributorUamiName": {
                                    "type": "string",
                                    "description": "Name of the User Assigned Managed Identity (UAMI) deployed by the foundation module.",
                                    "minLength": 3,
                                    "maxLength": 128
                                },
                                "monitoringUamiName": {
                                    "type": "string",
                                    "description": "Name of the User Assigned Managed Identity (UAMI) deployed by the foundation module.",
                                    "minLength": 3,
                                    "maxLength": 128
                                },
                                "logAnalyticsWorkspaceName": {
                                    "type": "string",
                                    "description": "Name of the Log Analytics Workspace deployed by the foundation module.",
                                    "minLength": 4,
                                    "maxLength": 63
                                },
                                "automationAccountName": {
                                    "type": "string",
                                    "description": "Name of the Automation Account deployed by the foundation module. Used by iac-bicep-cop-cred only.",
                                    "minLength": 6,
                                    "maxLength": 50
                                },
                                "actionGroupName": {
                                    "type": "string",
                                    "description": "Name of the Action Group deployed by the foundation module.",
                                    "minLength": 1,
                                    "maxLength": 260
                                },
                                "location": {
                                    "type": "string",
                                    "description": "Azure region used to resolve default names for foundation resources. Defaults to the deployment location if omitted."
                                }
                            }
                        }
                    }
                },
                "coResources": {
                    "type": "object",
                    "description": "Configuration for Cop-Credential-specific resources. Passed through unchanged to iac-bicep-cop-cred only; every other COP module ignores it.",
                    "required": ["value"],
                    "additionalProperties": false,
                    "properties": {
                        "value": {
                            "type": "object",
                            "description": "Object containing Cop-Credential resource settings.",
                            "additionalProperties": false,
                            "properties": {
                                "dceName": {
                                    "type": "string",
                                    "description": "Name of the Data Collection Endpoint (DCE) resource.",
                                    "minLength": 1,
                                    "maxLength": 64
                                },
                                "dceLocation": {
                                    "type": "string",
                                    "description": "Location of the Data Collection Endpoint (DCE) resource."
                                },
                                "dcrAppRegName": {
                                    "type": "string",
                                    "description": "Name of the Data Collection Rule (DCR) for AppRegCredentials_CL.",
                                    "minLength": 3,
                                    "maxLength": 64
                                },
                                "dcrAppRegLocation": {
                                    "type": "string",
                                    "description": "Location of the Data Collection Rule (DCR) for AppRegCredentials_CL."
                                },
                                "dcrKvName": {
                                    "type": "string",
                                    "description": "Name of the Data Collection Rule (DCR) for KeyVaultCredentials_CL.",
                                    "minLength": 3,
                                    "maxLength": 63
                                },
                                "dcrKvLocation": {
                                    "type": "string",
                                    "description": "Location of the Data Collection Rule (DCR) for KeyVaultCredentials_CL."
                                },
                                "lawTableAppReg": {
                                    "type": "string",
                                    "description": "Name of the Log Analytics Workspace table for AppRegCredentials_CL.",
                                    "minLength": 3,
                                    "maxLength": 64
                                },
                                "lawTableKv": {
                                    "type": "string",
                                    "description": "Name of the Log Analytics Workspace table for KeyVaultCredentials_CL.",
                                    "minLength": 3,
                                    "maxLength": 64
                                },
                                "lawTableRetentionDays": {
                                    "type": "integer",
                                    "description": "Analytics table retention in days, between 4 and 730. Defaults to 90.",
                                    "minimum": 4,
                                    "maximum": 730
                                },
                                "kvSubscriptionIds": {
                                    "type": "array",
                                    "description": "Subscription IDs to scan for Key Vaults. Empty array auto-discovers all subscriptions accessible to the Managed Identity at runtime.",
                                    "items": {
                                        "type": "string",
                                        "minLength": 36,
                                        "maxLength": 36,
                                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                                    }
                                },
                                "collectionScheduleHour": {
                                    "type": "integer",
                                    "description": "UTC hour at which the daily collection runbook is scheduled. 0 = midnight UTC.",
                                    "minimum": 0,
                                    "maximum": 23
                                },
                                "logAlertLocation": {
                                    "type": "string",
                                    "description": "Location of the Log search alert rule resources."
                                }
                            }
                        }
                    }
                },
                "policyAuthoringScope": {
                    "type": "object",
                    "description": "Management group holding the policy definitions. mg-scope deployments only.",
                    "required": ["value"],
                    "additionalProperties": false,
                    "properties": {
                        "value": {
                            "type": "string",
                            "description": "Name of the management group where the policy definitions are created. Must be at or above every managedScopeSet entry; equal is legal. Defaults to the management group the deployment targets.",
                            "minLength": 1,
                            "maxLength": 90
                        }
                    }
                },
                "managedScopeSet": {
                    "type": "object",
                    "description": "Management groups receiving the policy assignments, one nested deployment per entry. mg-scope deployments only.",
                    "required": ["value"],
                    "additionalProperties": false,
                    "properties": {
                        "value": {
                            "type": "array",
                            "description": "Array of management group names. An empty array resolves to [policyAuthoringScope], which reproduces the pre-split single-scope behaviour.",
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 90
                            }
                        }
                    }
                },
                "targetSubscriptionIds": {
                    "type": "object",
                    "description": "Subscription IDs forwarded to every COP module's diagnostics / DCR-association policy assignments. Required at sub-scope; not used at mg-scope. Not used by iac-bicep-cop-cred, which scans coResources.kvSubscriptionIds instead.",
                    "required": ["value"],
                    "additionalProperties": false,
                    "properties": {
                        "value": {
                            "type": "array",
                            "description": "Array of subscription GUIDs.",
                            "items": {
                                "type": "string",
                                "minLength": 36,
                                "maxLength": 36,
                                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                            }
                        }
                    }
                }
            }
        }
    }
}
