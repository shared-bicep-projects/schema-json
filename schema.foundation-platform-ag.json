{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "iac-bicep-foundation-platform-ag Module Deployment Parameters",
    "type": "object",
    "required": [
        "parameters"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "contentVersion": {
            "type": "string"
        },
        "parameters": {
            "type": "object",
            "required": [
                "customerNavId"
            ],
            "properties": {
                "managementSubscriptionGuid": {
                    "type": "object",
                    "required": [
                        "value"
                    ],
                    "properties": {
                        "value": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                        }
                    }
                },
                "monitoringRgName": {
                    "type": "object",
                    "required": [
                        "value"
                    ],
                    "properties": {
                        "value": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "customerNavId": {
                    "type": "object",
                    "required": [
                        "value"
                    ],
                    "properties": {
                        "value": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "actionGroupName": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "actionGroupShortName": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 12
                        }
                    }
                },
                "webhookBaseUri": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "string"
                        }
                    }
                },
                "functionCode": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "string"
                        }
                    }
                },
                "tags": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "object"
                        }
                    }
                },
                "rgTags": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "object"
                        }
                    }
                }
            },
            "additionalProperties": false
        }
    }
}
